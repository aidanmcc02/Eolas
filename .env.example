# Copy this to .env and fill in real values. Never commit .env.

# -- apps/api --
DATABASE_URL=postgresql://user:password@host:5432/eolas
ANTHROPIC_API_KEY=sk-ant-...
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:aidanmccarthy3@gmail.com

# AES-256-GCM key for encrypting message content and conversation titles at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required — the API will refuse to start without this.
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY

# Password gate for the web UI — enter this in the browser on first visit.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=REPLACE_WITH_RANDOM_KEY

# Optional: override the Anthropic model (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-opus-4-8

# -- apps/web (build-time) --
VITE_API_URL=https://your-api.railway.app

# -- apps/agents --
# Same DATABASE_URL and ANTHROPIC_API_KEY as api
OPENWEATHER_API_KEY=
